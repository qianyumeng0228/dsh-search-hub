{
  "name": "dsh-search-hub",
  "displayName": "Search Hub",
  "description": "侧边栏搜索渠道管理面板：一键配置多引擎 API Key、查看各引擎连通状态、调整回退顺序、切换当前搜索 provider。",
  "version": "0.1.0",
  "author": "local",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "search",
    "web-search"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --check index.js && node --check client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "react",
        "react-dom",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
}
